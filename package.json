{
	"name": "locus-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Locus — the exact code chunk for the job. Fast local BM25 search for agents.",
	"workspaces": [
		"packages/*",
		"packages/mcp-server/npm/*"
	],
	"bin": {
		"locus": "./bin/locus"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"clean": "turbo run clean",
		"type-check": "turbo run type-check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"docs:dev": "cd docs && bun run docs:dev",
		"build:rust": "cargo build --release -p coderag-core -p coderag-cli -p coderag-mcp-server && bun scripts/stage-rust-mcp.ts",
		"test:rust": "cargo test",
		"test:golden-retrieval": "bun run build:rust && bun test test/golden-retrieval.test.ts",
		"test:retrieval-parity": "bun run build:rust && bun test test/retrieval-parity.test.ts",
		"docs:build": "cd docs && bun run docs:build",
		"docs:preview": "cd docs && bun run docs:preview",
		"benchmark:public-proof": "bun run scripts/benchmark-public-proof.ts",
		"doctor": "bun run packages/mcp-server/src/doctor.ts",
		"benchmark:release-gate": "bun run build:rust && bun run scripts/release-gate.ts",
		"check:owned-runner-profiles": "bash scripts/check-owned-runner-profiles.sh",
		"changeset": "changeset",
		"version": "changeset version && bun scripts/sync-platform-versions.ts",
		"version-packages": "changeset version && bun scripts/sync-platform-versions.ts && bun install",
		"publish-packages": "bash scripts/publish-with-natives.sh",
		"sync:platform-versions": "bun scripts/sync-platform-versions.ts",
		"assemble:multiarch": "bun scripts/assemble-multiarch-natives.ts",
		"verify:multiarch-readback": "bun scripts/verify-multiarch-readback.ts",
		"release": "echo \"Direct changeset publish is unsafe for workspace packages; use the Sylphx release workflow.\" && exit 1",
		"typecheck": "turbo typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@changesets/cli": "3.0.3",
		"@sylphx/biome-config": "^0.4.0",
		"lefthook": "^2.0.4",
		"turbo": "^2.6.1",
		"typescript": "^7.0.2",
		"vitepress": "1.6.4",
		"vue": "^3.5.25"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.0"
	},
	"keywords": [
		"rag",
		"code-search",
		"retrieval-augmented-generation",
		"tfidf",
		"mcp",
		"model-context-protocol",
		"codebase-indexing",
		"locus",
		"local-first",
		"sylphx"
	],
	"author": "SylphxAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SylphxAI/locus.git"
	},
	"type": "module",
	"homepage": "https://sylphxai.github.io/locus/"
}
