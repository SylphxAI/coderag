{
	"name": "@sylphx/locus",
	"version": "0.5.1",
	"description": "Locus \u2014 local-first hybrid code search MCP/CLI/SDK for agents.",
	"type": "module",
	"main": "./dist/rust-engine.js",
	"bin": {
		"locus": "./bin/locus"
	},
	"exports": {
		"./evidence": {
			"types": "./dist/evidence.d.ts",
			"import": "./dist/evidence.js"
		},
		"./rust-engine": {
			"types": "./dist/rust-engine.d.ts",
			"import": "./dist/rust-engine.js"
		},
		"./search-coordinator": {
			"types": "./dist/search-coordinator.d.ts",
			"import": "./dist/search-coordinator.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"test": "bun test",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@sylphx/coderag": "workspace:*"
	},
	"optionalDependencies": {
		"@sylphx/locus-darwin-arm64": "0.5.1",
		"@sylphx/locus-darwin-x64": "0.5.1",
		"@sylphx/locus-linux-x64-gnu": "0.5.1",
		"@sylphx/locus-linux-arm64-gnu": "0.5.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.3",
		"@types/node": "^24.9.2",
		"typescript": "^7.0.2",
		"@biomejs/biome": "^2.3.12",
		"@sylphx/biome-config": "^0.4.1"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"rag",
		"retrieval-augmented-generation",
		"code-search",
		"ai-assistant",
		"coderag",
		"locus",
		"local-first",
		"sylphx",
		"hybrid-search"
	],
	"author": "SylphxAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SylphxAI/coderag.git",
		"directory": "packages/mcp-server"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"mcpName": "io.github.SylphxAI/locus"
}
